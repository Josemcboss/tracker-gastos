generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  apiKey            String?  @unique
  telegramChatId    String?  @unique
  telegramLinkToken String?  @unique
  createdAt         DateTime @default(now())

  expenses         Expense[]
  categories       Category[]
  incomes          Income[]
  incomeCategories IncomeCategory[]
  budgets          Budget[]
  subscriptions    Subscription[]
  savingGoals      SavingGoal[]
}

model Category {
  id        String  @id @default(uuid())
  name      String
  color     String
  icon      String
  isDefault Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses      Expense[]
  budgets       Budget[]
  subscriptions Subscription[]

  @@unique([name, userId])
}

model IncomeCategory {
  id        String  @id @default(uuid())
  name      String
  color     String
  icon      String
  isDefault Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  incomes Income[]

  @@unique([name, userId])
}

model Expense {
  id            String   @id @default(uuid())
  amount        Float
  description   String
  date          DateTime
  paymentMethod String?
  currency      String   @default("DOP")
  exchangeRate  Float    @default(1.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
}

model Income {
  id           String   @id @default(uuid())
  amount       Float
  description  String
  date         DateTime
  source       String?
  currency     String   @default("DOP")
  exchangeRate Float    @default(1.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   IncomeCategory @relation(fields: [categoryId], references: [id])
}

model Budget {
  id        String   @id @default(uuid())
  amount    Float
  month     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

model Subscription {
  id            String   @id @default(uuid())
  name          String
  amount        Float
  billingDay    Int
  billingCycle  String   @default("monthly")
  paymentMethod String?
  isActive      Boolean  @default(true)
  currency      String   @default("DOP")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model SavingGoal {
  id            String    @id @default(uuid())
  title         String
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?
  color         String    @default("#8B5CF6")
  icon          String    @default("Target")
  currency      String    @default("DOP")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
